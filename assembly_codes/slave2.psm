; ==========================================================
; slave 2 - manager for nodes 5-9
; ==========================================================

; --- register names ---
NAMEREG s0, reg_cmd        ; current command
NAMEREG s1, reg_ptr        ; loop counter (starts from 5)
NAMEREG s2, reg_val_a      ; temporary variable a
NAMEREG s3, reg_val_b      ; temporary variable b
NAMEREG s4, global_u       ; current node u
NAMEREG s5, global_dist    ; distance of u
NAMEREG s6, mem_addr       ; ram address
NAMEREG s7, min_node       ; nearest node found
NAMEREG s8, min_dist       ; shortest distance found

; --- port definitions (same as slave 1) ---
; the hardware separates the signals, so ports look the same
CONSTANT P_CMD,       01   
CONSTANT P_ARG_U,     02   
CONSTANT P_ARG_DIST,  03   
CONSTANT P_STATUS,    04   
CONSTANT P_RES_NODE,  05   
CONSTANT P_RES_DIST,  06   

; memory wrapper ports
CONSTANT MEM_ADDR_PTR, F0  
CONSTANT MEM_DATA_WR,  F1  
CONSTANT MEM_DATA_RD,  F2  

; memory map
CONSTANT BASE_DIST,    64  ; hex 64 = dec 100
CONSTANT BASE_VISIT,   6E  ; hex 6e = dec 110

; commands
CONSTANT CMD_IDLE,    00
CONSTANT CMD_INIT,    01
CONSTANT CMD_FIND,    02
CONSTANT CMD_RELAX,   03
CONSTANT CMD_REPORT,  04

; ==========================================================
; main loop
; ==========================================================

idle_loop:
    INPUT reg_cmd, P_CMD
    
    COMPARE reg_cmd, CMD_IDLE
    JUMP Z, idle_loop

    COMPARE reg_cmd, CMD_INIT
    JUMP Z, do_init

    COMPARE reg_cmd, CMD_FIND
    JUMP Z, do_find

    COMPARE reg_cmd, CMD_RELAX
    JUMP Z, do_relax

    JUMP idle_loop

; ==========================================================
; task 1: init
; ==========================================================
do_init:
    ; *** difference 1: loop starts from 5 ***
    LOAD reg_ptr, 05         

init_loop:
    ; --- set distance ---
    LOAD mem_addr, BASE_DIST
    ADD mem_addr, reg_ptr
    OUTPUT mem_addr, MEM_ADDR_PTR
    
    ; *** difference 2: node 0 is not here, so set all to infinity ***
    LOAD reg_val_a, FF       
    OUTPUT reg_val_a, MEM_DATA_WR

    ; --- set visited ---
    LOAD mem_addr, BASE_VISIT
    ADD mem_addr, reg_ptr
    OUTPUT mem_addr, MEM_ADDR_PTR
    
    LOAD reg_val_a, 00       ; false (not visited)
    OUTPUT reg_val_a, MEM_DATA_WR

    ; loop control (for nodes 5, 6, 7, 8, 9)
    ADD reg_ptr, 01
    COMPARE reg_ptr, 0A      ; exit when 10 (hex 0a)
    JUMP NZ, init_loop

    JUMP signal_done

; ==========================================================
; task 2: find min
; ==========================================================
do_find:
    LOAD min_dist, FF        
    LOAD min_node, FF        
    LOAD reg_ptr, 05         ; start search from 5

find_loop:
    ; 1. check visited status
    LOAD mem_addr, BASE_VISIT
    ADD mem_addr, reg_ptr
    OUTPUT mem_addr, MEM_ADDR_PTR
    INPUT reg_val_a, MEM_DATA_RD 
    
    COMPARE reg_val_a, 01        
    JUMP Z, skip_node            ; if visited, skip

    ; 2. read distance
    LOAD mem_addr, BASE_DIST
    ADD mem_addr, reg_ptr
    OUTPUT mem_addr, MEM_ADDR_PTR
    INPUT reg_val_a, MEM_DATA_RD 

    ; 3. compare: current < min ?
    COMPARE reg_val_a, min_dist
    JUMP NC, skip_node           ; if not smaller, skip

    ; 4. found new min
    LOAD min_dist, reg_val_a
    LOAD min_node, reg_ptr

skip_node:
    ADD reg_ptr, 01
    COMPARE reg_ptr, 0A      ; exit when 10
    JUMP NZ, find_loop

    ; 5. write result
    OUTPUT min_node, P_RES_NODE
    OUTPUT min_dist, P_RES_DIST
    
    JUMP signal_done

; ==========================================================
; task 3: relax (update neighbors)
; ==========================================================
do_relax:
    INPUT global_u, P_ARG_U
    INPUT global_dist, P_ARG_DIST

    ; --- mark visited ---
    ; check if u belongs to me (u >= 5)
    COMPARE global_u, 05
    JUMP C, start_relax_loop ; if u < 5 (carry set), it is not mine
    
    ; set visited[u] = 1
    LOAD mem_addr, BASE_VISIT
    ADD mem_addr, global_u
    OUTPUT mem_addr, MEM_ADDR_PTR
    LOAD reg_val_a, 01
    OUTPUT reg_val_a, MEM_DATA_WR

start_relax_loop:
    LOAD reg_ptr, 05          ; start v from 5

relax_loop:
    ; 1. calculate address w[u][v]
    ; logic: (u * 10) + v
    LOAD sA, global_u
    SL0 sA                    ; x2
    LOAD sB, sA               
    SL0 sA                    ; x4
    SL0 sA                    ; x8
    ADD sA, sB                ; 10*u
    ADD sA, reg_ptr           ; + v
    LOAD mem_addr, sA         
    
    ; 2. read weight
    OUTPUT mem_addr, MEM_ADDR_PTR
    INPUT reg_val_a, MEM_DATA_RD 

    ; 3. does road exist?
    COMPARE reg_val_a, FF
    JUMP Z, next_v            ; no road, skip

    ; 4. calculate new distance
    ADD reg_val_a, global_dist
    JUMP C, next_v            ; check for overflow
    
    ; 5. read current dist[v]
    LOAD mem_addr, BASE_DIST
    ADD mem_addr, reg_ptr     
    OUTPUT mem_addr, MEM_ADDR_PTR
    INPUT reg_val_b, MEM_DATA_RD 

    ; 6. compare: new (reg_val_a) < old (reg_val_b) ?
    ; if new is smaller, borrow (carry) occurs
    COMPARE reg_val_a, reg_val_b
    JUMP C, update_dist       ; if carry set, update
    JUMP next_v               ; else skip

update_dist:
    OUTPUT reg_val_a, MEM_DATA_WR

next_v:
    ADD reg_ptr, 01
    COMPARE reg_ptr, 0A       ; exit when 10
    JUMP NZ, relax_loop

    JUMP signal_done

; ==========================================================
; common finish
; ==========================================================
signal_done:
    LOAD reg_val_a, 02
    OUTPUT reg_val_a, P_STATUS

wait_ack:
    INPUT reg_cmd, P_CMD
    COMPARE reg_cmd, 00
    JUMP NZ, wait_ack

    LOAD reg_val_a, 00
    OUTPUT reg_val_a, P_STATUS
    JUMP idle_loop